# Oracle Cloud Always Free (4 OCPU ARM64 / 24 GB RAM) — Copy to .env and set SUB_KEY

# Generate with: openssl rand -hex 24
SUB_KEY=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_24
PUBLIC_BASE_URL=https://vless.hijrahvpn.uk
DOMAIN=vless.hijrahvpn.uk

# Server & Scheduler
HOST=0.0.0.0
PORT=8080
UPDATE_INTERVAL_MINUTES=15
RUN_ON_STARTUP=1
RATE_LIMIT_PER_MINUTE=60
TRUST_X_FORWARDED_FOR=1

# Tuned for 4 OCPU / 24 GB RAM
CONCURRENCY=120
DNS_CONCURRENCY=64
FETCH_CONCURRENCY=20
E2E_VERIFY=1
E2E_CONCURRENCY=48
E2E_BATCH_SIZE=32
E2E_TIMEOUT=8.0
E2E_CACHE_MINUTES=45
E2E_FAILURE_CACHE_MINUTES=15

# Quality, Speedtest & TSPU Filtering
ONLY_RU_IPS=1
REJECT_RU_EXIT=1
FILTER_POISONED_SNI=1
E2E_SPEEDTEST_BYTES=131072
E2E_MIN_SPEED_KBPS=256
# Optional: SOCKS5/HTTP proxy inside RU to test nodes through real TSPU (e.g. socks5://user:pass@ru-ip:1080)
RU_ENTRY_PROXY=
NODE_MIN_RECENT_SUCCESS=1
MAX_PER_ENDPOINT=6
PUBLISH_PER_ENDPOINT=2
MAX_PER_SUBNET=6
MAX_PER_DOMAIN=10
MIN_ALIVE=10
